# 数据库连接（本地 MVP 使用 SQLite 文件，后续可切换 PostgreSQL/Supabase）
DATABASE_URL="file:./data/tiku.db"

# 登录会话密钥：请改成一段足够长的随机字符串（至少 32 位）
SESSION_SECRET="please-change-this-to-a-long-random-string-32chars"

# 可选：配置后"生成计划"时可调用大模型做 AI 润色；不配置也能正常生成（规则引擎）
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# 可选：设置后，新教练注册必须填写此邀请码（防止陌生人注册）；留空=开放注册
INVITE_CODE=""

# 仅使用 Turso 远程库时需要：其 auth token
LIBSQL_AUTH_TOKEN=""
